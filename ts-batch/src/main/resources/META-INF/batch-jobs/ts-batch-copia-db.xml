<?xml version="1.0" encoding="UTF-8"?>
<!--
    Copia i record della query demo da un database Oracle a una tabella PostgreSQL.

    Parametri del job:
      codiceCompagnia               (obbligatorio) filtro della query, scritto anche nella tabella di destinazione

      origine (Oracle):
      origineDataSourceJndi         DataSource JNDI, in alternativa a
      origineJdbcUrl / origineJdbcUser / origineJdbcPassword   es. jdbc:oracle:thin:@//host:1521/SERVIZIO
      query                         (opzionale) query alternativa a quella demo, un solo parametro: il codice compagnia
      fetchSize                     (opzionale, default 500)

      destinazione (PostgreSQL):
      destinazioneDataSourceJndi    DataSource JNDI, in alternativa a
      destinazioneJdbcUrl / destinazioneJdbcUser / destinazioneJdbcPassword   es. jdbc:postgresql://host:5432/db
      insert                        (opzionale) insert alternativa, parametri: compagnia, descrizione, importo,
                                    data riferimento, data elaborazione
      cancellaEsistenti             (opzionale, default true) cancella le righe già presenti per il codice compagnia
      delete                        (opzionale) delete alternativa, un solo parametro: il codice compagnia

    DDL di esempio: sql/oracle/demo_polizza.sql, sql/postgres/demo_polizza_copia.sql
-->
<job id="ts-batch-copia-db" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/jobXML_1_0.xsd"
     version="1.0">

    <step id="copiaOracleSuPostgres">
        <chunk item-count="500">
            <reader ref="demoQueryItemReader">
                <properties>
                    <property name="codiceCompagnia" value="#{jobParameters['codiceCompagnia']}"/>
                    <property name="query" value="#{jobParameters['query']}"/>
                    <property name="dataSourceJndi" value="#{jobParameters['origineDataSourceJndi']}"/>
                    <property name="jdbcUrl" value="#{jobParameters['origineJdbcUrl']}"/>
                    <property name="jdbcUser" value="#{jobParameters['origineJdbcUser']}"/>
                    <property name="jdbcPassword" value="#{jobParameters['origineJdbcPassword']}"/>
                    <property name="fetchSize" value="#{jobParameters['fetchSize']}?:500;"/>
                </properties>
            </reader>
            <writer ref="dbTableItemWriter">
                <properties>
                    <property name="codiceCompagnia" value="#{jobParameters['codiceCompagnia']}"/>
                    <property name="insert" value="#{jobParameters['insert']}"/>
                    <property name="delete" value="#{jobParameters['delete']}"/>
                    <property name="cancellaEsistenti" value="#{jobParameters['cancellaEsistenti']}?:true;"/>
                    <property name="dataSourceJndi" value="#{jobParameters['destinazioneDataSourceJndi']}"/>
                    <property name="jdbcUrl" value="#{jobParameters['destinazioneJdbcUrl']}"/>
                    <property name="jdbcUser" value="#{jobParameters['destinazioneJdbcUser']}"/>
                    <property name="jdbcPassword" value="#{jobParameters['destinazioneJdbcPassword']}"/>
                </properties>
            </writer>
        </chunk>
    </step>
</job>
