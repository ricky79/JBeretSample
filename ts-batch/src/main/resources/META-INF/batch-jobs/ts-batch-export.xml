<?xml version="1.0" encoding="UTF-8"?>
<!--
    Esporta su file CSV il risultato della query demo filtrata per codice compagnia.
    Il primo step calcola il valore filtro passato come secondo parametro alla query dell'export.

    Parametri del job:
      codiceCompagnia    (obbligatorio) filtro della query, riportato nella prima riga del file
      fileOutput         (obbligatorio) percorso del file CSV da generare
      intestazione       (opzionale, default true) scrive la riga con i nomi delle colonne
      separatore         (opzionale, default ;)
      encoding           (opzionale, default UTF-8)
      dataSourceJndi     (opzionale) DataSource JNDI; in alternativa jdbcUrl/jdbcUser/jdbcPassword
      queryValoreFiltro  (opzionale) query alternativa a quella demo che calcola il valore filtro,
                         con un solo parametro (il codice compagnia) e una sola colonna
      query              (opzionale) query alternativa a quella demo, con due parametri:
                         il codice compagnia e il valore filtro
-->
<job id="ts-batch-export" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/jobXML_1_0.xsd"
     version="1.0">

    <!-- il valore è nei transient user data, non persistiti: in caso di restart va ricalcolato -->
    <step id="recuperaValoreFiltro" next="esportaCsv" allow-start-if-complete="true">
        <batchlet ref="valoreFiltroBatchlet">
            <properties>
                <property name="codiceCompagnia" value="#{jobParameters['codiceCompagnia']}"/>
                <property name="query" value="#{jobParameters['queryValoreFiltro']}"/>
                <property name="dataSourceJndi" value="#{jobParameters['dataSourceJndi']}"/>
                <property name="jdbcUrl" value="#{jobParameters['jdbcUrl']}"/>
                <property name="jdbcUser" value="#{jobParameters['jdbcUser']}"/>
                <property name="jdbcPassword" value="#{jobParameters['jdbcPassword']}"/>
            </properties>
        </batchlet>
    </step>

    <step id="esportaCsv">
        <chunk item-count="500">
            <reader ref="demoQueryItemReader">
                <properties>
                    <property name="codiceCompagnia" value="#{jobParameters['codiceCompagnia']}"/>
                    <property name="query" value="#{jobParameters['query']}"/>
                    <property name="dataSourceJndi" value="#{jobParameters['dataSourceJndi']}"/>
                    <property name="jdbcUrl" value="#{jobParameters['jdbcUrl']}"/>
                    <property name="jdbcUser" value="#{jobParameters['jdbcUser']}"/>
                    <property name="jdbcPassword" value="#{jobParameters['jdbcPassword']}"/>
                    <property name="fetchSize" value="#{jobParameters['fetchSize']}?:500;"/>
                </properties>
            </reader>
            <writer ref="csvFileItemWriter">
                <properties>
                    <property name="fileOutput" value="#{jobParameters['fileOutput']}"/>
                    <property name="codiceCompagnia" value="#{jobParameters['codiceCompagnia']}"/>
                    <property name="intestazione" value="#{jobParameters['intestazione']}?:true;"/>
                    <property name="separatore" value="#{jobParameters['separatore']}"/>
                    <property name="encoding" value="#{jobParameters['encoding']}?:UTF-8;"/>
                </properties>
            </writer>
        </chunk>
    </step>
</job>
